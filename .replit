[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "API execute enabled data"
mode = "sequential"
author = 21294

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Project"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = '''curl -X POST \   -H "Content-Type: application/json" \   -H "x-api-key: $LIVE_API_KEY" \   -d '{"userId": "dev-user"}' \   https://shape-studio-NSDesign.replit.app/api/live/sets/enabled \   | jq -c '{data: .data}' \   | curl -X POST \     -H "Content-Type: application/json" \     -H "x-api-key: $LIVE_API_KEY" \     -d @- \     https://shape-studio-NSDesign.replit.app/api/live/sets/execute'''
